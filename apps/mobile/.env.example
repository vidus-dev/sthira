# Where the app finds the Sthira API (no trailing slash). Copy to .env.
# See docs/newplan/03-run-host-install.md.
#
# Phone with Expo Go on the same Wi-Fi as the laptop → the laptop's Wi-Fi IP
# (run `ipconfig`, use "IPv4 Address"; start the API with --host 0.0.0.0):
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.1.23:8000
# Browser preview (`npx expo start --web`) → use localhost on both sides so the
# session cookie is sent (start the API with CORS_ORIGINS=http://localhost:8081):
#   EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
# Android emulator → host machine:
#   EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000
# Installed APK → the hosted API (set in eas.json, not here).
#
# Optional timeout (ms), default 25000:
# EXPO_PUBLIC_API_TIMEOUT_MS=25000

EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
